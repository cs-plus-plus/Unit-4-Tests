{
  "name": "Java Dev Container",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven",
        "vscjava.vscode-java-test"
      ],
      "settings": {
        "java.test.defaultConfig": "junit"
      }
    }
  },
  "postCreateCommand": "mvn --version"
}
